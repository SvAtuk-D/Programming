#include <iostream>
#include <iomanip>
#include <string>

using namespace std;

int main() {
    double start, step;
    int rows;
    const string line = "---------------------------------------------------";

    cout << "Start value: ";
    while (!(cin >> start)) { cin.clear(); cin.get(); cout << "Error. Start value: "; }

    cout << "Step: ";
    while (!(cin >> step)) { cin.clear(); cin.get(); cout << "Error. Step: "; }

    do {
        cout << "Number of rows (10-15): ";
        if (!(cin >> rows)) { cin.clear(); cin.get(); rows = 0; }
    } while (rows < 10 || rows > 15);

    cout << "\n" << line << "\n";
    cout << "| " << left << setw(15) << "carat" << " | " << setw(15) << "g" << " | " << setw(15) << "grains" << " |\n";
    cout << line << "\n";

    cout << fixed << setprecision(4) << right;
    double x = start;
    for (int i = 0; i < rows; i++) {
        cout << "| " << setw(15) << x << " | " << setw(15) << x * 0.2 << " | " << setw(15) << x * 2.9412 << " |\n";
        x += step;
    }
    cout << line << "\n";

    return 0;
}
